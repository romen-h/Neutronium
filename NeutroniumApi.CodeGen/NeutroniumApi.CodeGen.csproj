<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);AddAnalyzerDependenciesToTargetPath</GetTargetPathDependsOn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true"/>
		<PackageReference Include="System.Runtime.Loader" Version="4.3.0" PrivateAssets="all" GeneratePathProperty="true"/>
	</ItemGroup>

	<Target Name="PackAnalyzerDependencies" BeforeTargets="_GetAnalyzerFiles">
		<ItemGroup>
			<!-- Pack the dependency into the analyzer directory so the compiler can find it -->
			<None Include="$(PkgSystem_Reflection_MetadataLoadContext)\lib\netstandard2.0\System.Reflection.MetadataLoadContext.dll"
			      Pack="true"
			      PackagePath="analyzers/dotnet/cs"
			      Visible="false" />
		</ItemGroup>
	</Target>

	<Target Name="AddAnalyzerDependenciesToTargetPath">
		<ItemGroup>
			<!-- Explicitly tells the compiler to load this DLL alongside your generator -->
			<TargetPathWithTargetPlatformMoniker Include="$(PkgSystem_Reflection_MetadataLoadContext)\lib\netstandard2.0\System.Reflection.MetadataLoadContext.dll" IncludeRuntimeOutputs="false" />
		</ItemGroup>
	</Target>

	<Target Name="GetDependencyTargetPaths">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(TargetDir)\*.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

</Project>
