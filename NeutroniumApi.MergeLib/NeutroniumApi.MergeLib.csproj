<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Neutronium.MergeLib.Api</RootNamespace>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="SolutionDir" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(SolutionDir)\NeutroniumApi.CodeGen\NeutroniumApi.CodeGen.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="False" />
		<Reference Include="UnityEngine">
			<HintPath>$(UnityLibsFolder)/UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(UnityLibsFolder)/UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="VerifySourceGeneratorOutput" AfterTargets="BeforeCompile">
		<PropertyGroup>
			<!-- Adjust this path to match your exact Generator assembly name and expected file name -->
			<ExpectedGeneratorFile>$(CompilerGeneratedFilesOutputPath)\NeutroniumApi.CodeGen\NeutroniumApi.CodeGen.SourceGenerator\Neutronium.Api.IApiRoot_Wrapper.g.cs</ExpectedGeneratorFile>
		</PropertyGroup>

		<Error
			Condition="!Exists('$(ExpectedGeneratorFile)')"
			Text="Build Failed: The Roslyn Incremental Generator failed to run or did not generate '$(ExpectedGeneratorFile)'. Ensure the generator project is built and the Analyzer item group is configured correctly." />
	</Target>

</Project>